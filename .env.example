# Local development
MARKETS_SERVICE_URL=http://127.0.0.1:8080

# Production: set this to the live backend URL, e.g.
# MARKETS_SERVICE_URL=https://markets-service-production.up.railway.app

# Live order book stream (markets-service `GET /v1/ws`). The browser connects directly, so this
# must be client-reachable and the frontend origin must be in the backend's WS_ALLOWED_ORIGINS.
# Local: ws://127.0.0.1:8080/v1/ws · Production: wss://api.numofx.com/v1/ws
NEXT_PUBLIC_MARKETS_WS_URL=ws://127.0.0.1:8080/v1/ws
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_BASE_RPC_URL=https://sepolia.base.org

# Blocks per `eth_getLogs` call when looking up a wallet's trading subaccount. Leave unset and it
# falls back to 2000 — what the public Base RPCs accept, and slow enough (~418 sequential calls,
# around seven minutes) that the order form's submit button stays disabled for the whole scan.
# Providers with a higher limit collapse this to one call; Alchemy serves the full range in ~1.1s.
# Raise it only to what your configured NEXT_PUBLIC_BASE_RPC_URL actually allows — too large a
# value makes that provider reject every query, which is why this stays commented out next to the
# public RPC above. With an Alchemy/QuickNode URL, uncomment it:
# NEXT_PUBLIC_LOG_QUERY_BLOCK_RANGE=1000000
NEXT_PUBLIC_MATCHING_CHAIN_ID=84532
NEXT_PUBLIC_MATCHING_ADDRESS=0x1599636347FD5bA1fBE21D58AfE0b8B9cbe283FF
NEXT_PUBLIC_TRADE_MODULE_ADDRESS=0x0AAE65AaA66Fe7f54486cDbD007956d3De611990
NEXT_PUBLIC_SUBACCOUNT_CREATOR_ADDRESS=0x5448B304AD283f24A741B54AE9b3a71C8d7DCDF2
NEXT_PUBLIC_USDCCNGN_MANAGER_ADDRESS=0x1917960763BF3a0DfA10a05f0a112E828C1A934f

# risk-core `DeliverableFXManager`, read for the order ticket's initial-margin requirement. Optional:
# the app already knows the deployed address for Base mainnet and Base Sepolia, so set this only to
# point at a different deployment. Not to be confused with NEXT_PUBLIC_USDCCNGN_MANAGER_ADDRESS
# above, which names an address absent from every risk-core deployment artifact.
# NEXT_PUBLIC_DELIVERABLE_FX_MANAGER_ADDRESS=
NEXT_PUBLIC_USDC_DELIVERABLE_BASE_ASSET_ADDRESS=0x8b3C43D2b2555ca3fc4Fa1BC34544133B8576110
NEXT_PUBLIC_USDCCNGN_APR_FUTURE_ASSET_ADDRESS=0xCE2846771074E20fEc739CF97a60E6075D1E464b
NEXT_PUBLIC_USDCCNGN_APR_FUTURE_SUB_ID=1777507200
